# Server
PORT=3000
NODE_ENV=development

# Postgres (one of DATABASE_URL OR individual params)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tshwane
PGHOST=localhost
PGPORT=5432
PGDATABASE=tshwane
PGUSER=postgres
PGPASSWORD=postgres

# Security
JWT_SECRET=dev_secret
REFRESH_SECRET=dev_refresh_secret
JWT_EXPIRES_IN=86400
REFRESH_EXPIRES_IN=604800
BCRYPT_ROUNDS=10

# Optional
PGSSLMODE=disable
